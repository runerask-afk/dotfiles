# 1. Initialize ble.sh at the very top (must run before interactive elements)
if [ -f "$HOME/.local/share/blesh/ble.sh" ]; then
    source "$HOME/.local/share/blesh/ble.sh"
fi

# 2. History Settings
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend

# Don't save duplicate lines or lines starting with a space in history
HISTCONTROL=ignoreboth:erasedups

# Save multi-line commands as a single history entry
shopt -s cmdhist

# Check terminal window size after each command and update LINES and COLUMNS if needed
shopt -s checkwinsize

# Correct minor typos in directory names when using 'cd'
shopt -s cdspell

# Automatically prepend 'cd' when entering a plain directory path
shopt -s autocd

# 3.1 Aliases & Color Defaults
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias cp='cp -i'
alias mv='mv -i'
alias cdi="zi"

# 3.2 Aliases (Eza replacing standard ls)
if command -v eza &> /dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -l --icons --group-directories-first --git'
    alias la='eza -la --icons --group-directories-first --git'
    alias lt='eza --tree --icons --level=2'
fi


# 4. Initialize FZF (Interactive search)
if command -v fzf &> /dev/null; then
    [ -f ~/.fzf.bash ] && source ~/.fzf.bash
fi

# 5. Initialize Zoxide (Smart directory jumper)
if command -v zoxide &> /dev/null; then
    eval "$(zoxide init bash --cmd cd)"
fi

# 6. Initialize Starship Prompt (Must be initialized last)
if command -v starship &> /dev/null; then
    eval "$(starship init bash)"
fi

# 7. Set default editor for system tools and Git
export EDITOR="nano"
export VISUAL="nano"

export PATH="$HOME/.local/bin:$PATH"

# Display Fastfetch on interactive login 
if command -v fastfetch &> /dev/null && [ -z "$FASTFETCH_DISPLAYED" ]; then
    export FASTFETCH_DISPLAYED=1
    fastfetch
fi
